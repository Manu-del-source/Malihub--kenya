# =============================================================================
# MaliHub Kenya — FastAPI backend
#
# Copy to `backend/.env` and fill in. Run the server from `backend/` so this
# file is the one that gets picked up:
#
#     cd backend && cp .env.example .env && uvicorn app.main:app --reload
#
# Real environment variables always win over this file. NEVER commit `.env`
# (it is gitignored); every value below is a safe placeholder.
#
# Most of these are the SAME services the Next.js app talks to, so in many
# cases you can copy the value straight out of the root `.env.local` — the
# notes say where that's true and where the backend wants a different form.
# =============================================================================


# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                    # json (production) | console (local reading)
APP_NAME="MaliHub Kenya API"
APP_VERSION=0.8.0
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

# Public https:// URL of THIS backend. Payment providers call back to it, so it
# cannot be derived from a request behind a proxy. Production startup fails if
# this still points at localhost.
BACKEND_PUBLIC_URL=http://localhost:8000

# OpenAPI/Swagger. Must be false in production — startup refuses otherwise.
ENABLE_DOCS=true

# Echo SQL to the log. Must be false in production: it writes payment amounts,
# phone numbers and email addresses into the log stream.
DATABASE_ECHO=false


# ─── PostgreSQL (application database) ───────────────────────────────────────
# Independent, standard PostgreSQL — Neon, RDS, Cloud SQL, Supabase or
# self-hosted. Nothing here assumes a Supabase-specific feature.
#
# Same value as the root .env.local's DATABASE_URL; `postgres://`,
# `postgresql://` and `postgresql+asyncpg://` are all accepted and normalized
# automatically. Use the POOLED connection string here (this is a long-running
# server, not a serverless function).
DATABASE_URL=
# Not read by the backend — Prisma owns migrations and is the only thing that
# needs the unpooled/direct URL. Listed so the pairing is obvious.
# DIRECT_URL=

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800


# ─── Redis (cache / rate limiting / temporary state) ─────────────────────────
# Standard redis:// or rediss:// URL. Point this at the SAME Upstash database
# the Next.js app uses — Upstash exposes both a REST endpoint (which
# src/lib/redis.ts uses) and a TCP endpoint (which this uses). One Redis, two
# clients, shared `malihub:` key namespace.
#
#   Upstash console → your database → REST API section shows
#   "redis://default:<password>@<host>:<port>" alongside the HTTPS URL.
#
# Not a datastore. Anything here must be safe to lose.
REDIS_URL=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_KEY_PREFIX=malihub

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120   # matches the frontend's `api` bucket
RATE_LIMIT_FAIL_OPEN=true            # false = fail closed (see services/rate_limit.py)


# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated EXACT browser origins. No wildcards: a literal `*` here is
# rejected at startup, and an empty list is rejected in production.
#
# `allow_credentials=true` + `*` is refused by browsers anyway, and without
# credentials a wildcard would let any site script this API on a logged-in
# user's behalf. So there is no configuration in which `*` is the right answer.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional, for preview deployments with generated hostnames. Anchored
# automatically. Leave unset unless you need it. Example:
#   CORS_ORIGIN_REGEX=^https://malihub-.*\.vercel\.app$
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=600

# Public URL of the Next.js frontend. Used in transactional email links.
# Same as the root .env.local's NEXT_PUBLIC_APP_URL.
FRONTEND_URL=http://localhost:3000


# ─── Supabase — AUTHENTICATION ONLY ──────────────────────────────────────────
# Supabase is MaliHub's identity provider and nothing else. This backend
# VERIFIES tokens Supabase signed. It stores no passwords, runs no login or
# signup, and never uses the service-role key.
#
# The frontend already holds the access token; it forwards it as
# `Authorization: Bearer <token>`. See app/core/security.py.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Verification mode — pick ONE:
#
#   (a) HS256, the default for projects on Supabase's legacy shared secret.
#       Dashboard → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHMS=HS256

#   (b) Asymmetric signing (newer Supabase projects). Set the algorithm and
#       install the extra:  pip install '.[jwks]'
#       SUPABASE_JWT_ALGORITHMS=RS256
#       The JWKS URL below is derived from SUPABASE_URL automatically; set it
#       explicitly only if yours differs.
# SUPABASE_JWKS_URL=

SUPABASE_JWT_ISSUER=                 # defaults to {SUPABASE_URL}/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=30

# NEVER set this in the backend. The service role bypasses RLS entirely and
# this service has no legitimate use for it. Its presence in a backend
# environment is a finding, not a configuration.
# SUPABASE_SERVICE_ROLE_KEY=


# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Same key as the root .env.local's RESEND_API_KEY. Without it, email sends are
# skipped (logged once, never queued, never retried) — matching the behaviour of
# src/services/email-service.ts so local development needs no Resend account.
EMAIL_PROVIDER=resend                # resend | none
RESEND_API_KEY=
EMAIL_FROM="MaliHub Kenya <notifications@malihub.co.ke>"
EMAIL_REPLY_TO=
RESEND_BASE_URL=https://api.resend.com
EMAIL_TIMEOUT_SECONDS=10


# ─── Storage (external provider — NEVER Supabase Storage) ────────────────────
# Same Cloudinary account as the root .env.local.
#
# Phase 8 status: URL derivation and upload policy validation work; actual
# server-side upload/delete are stubs, because listing images are uploaded
# directly from the browser by next-cloudinary's unsigned widget and nothing
# needs a server-side path yet. See app/providers/storage/cloudinary.py.
STORAGE_PROVIDER=cloudinary          # cloudinary | none
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=malihub
CLOUDINARY_BASE_URL=https://api.cloudinary.com/v1_1
CLOUDINARY_SECURE_BASE_URL=https://res.cloudinary.com
STORAGE_MAX_UPLOAD_BYTES=8388608     # 8 MiB
STORAGE_TIMEOUT_SECONDS=20


# ─── Payments ────────────────────────────────────────────────────────────────
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  PHASE 8 SHIPS NO WORKING PAYMENT INTEGRATION.                           ║
# ║                                                                          ║
# ║  These are placeholders and configuration boundaries only. No request    ║
# ║  anywhere in this backend calls PayHero, Safaricom or Daraja. Filling    ║
# ║  them in will NOT make payments work — the adapter is a typed stub that  ║
# ║  returns 501, and no payment or webhook route is mounted. Real PayHero   ║
# ║  integration is Phase 9.                                                 ║
# ║                                                                          ║
# ║  Leave PAYHERO_ENABLED=false and every credential empty until then.      ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Which provider a caller gets when it doesn't name one. DARAJA is not a valid
# value: it is reserved in the schema for a future provider and has no adapter.
PAYMENTS_DEFAULT_PROVIDER=PAYHERO

PAYHERO_ENABLED=false
# PayHero credentials: API Username + API Password (Basic auth).
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# PayHero v2 API root — https://docs.payhero.co.ke
# Phase 9 must confirm the sandbox/testing host before pointing this at a test
# account.
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
# Our registered payment channel ID (PayHero dashboard → Payment Channels).
PAYHERO_CHANNEL_ID=
# PayHero's own `provider` request field — the rail WITHIN PayHero. Not the same
# concept as PAYMENTS_DEFAULT_PROVIDER, which identifies the processor.
PAYHERO_DEFAULT_CHANNEL_PROVIDER=m-pesa
# Optional: route through our own Daraja credentials instead of PayHero's.
PAYHERO_CREDENTIAL_ID=
# Shared secret for callback signature verification. Phase 9 must confirm with
# PayHero whether callbacks are signed and with what; until it does, a callback
# is treated as a hint and confirmed by an authenticated status call.
PAYHERO_WEBHOOK_SECRET=
PAYHERO_TIMEOUT_SECONDS=15

# Daraja / Safaricom M-Pesa: NOT IMPLEMENTED, no configuration, no code path.
# Reserved for a future provider. Do not add MPESA_* variables here in the
# expectation that they do something — see ARCHITECTURE.md §7.


# ─── Production checklist ────────────────────────────────────────────────────
# Startup refuses to boot a production deployment (ENVIRONMENT=production) when
# any of these are wrong, rather than running with a control silently off:
#
#   ENVIRONMENT=production
#   DEBUG=false
#   ENABLE_DOCS=false
#   DATABASE_ECHO=false
#   CORS_ORIGINS=<your real frontend origin(s)>   # never empty, never *
#   DATABASE_URL=<pooled postgres DSN>
#   REDIS_URL=<redis DSN>
#   BACKEND_PUBLIC_URL=https://api.your-domain    # not localhost
#   SUPABASE_JWT_SECRET=… (or JWKS + an asymmetric algorithm)
