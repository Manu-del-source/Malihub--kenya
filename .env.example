# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MaliHub Kenya"
NODE_ENV=development

# ─── Supabase — AUTHENTICATION ────────────────────────────────────
# Supabase issues and verifies user sessions. It is NOT the application
# database, and there is no second auth system: passwords live only in
# Supabase Auth. Marketplace images go to Cloudinary, not to Supabase Storage
# (the one Phase 4 exception is profile avatars). See ARCHITECTURE.md §2, §11.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The FastAPI backend verifies Supabase-issued JWTs with this (HS256) or with
# SUPABASE_JWKS_URL instead. It never uses the service-role key, and refuses a
# service-role token presented as a user token.
SUPABASE_JWT_SECRET=

# ─── Application database (independent PostgreSQL) ────────────────
# Managed Postgres of your choice — Neon, Supabase Postgres, RDS, … The code
# uses no Supabase-specific database features, so any standard PostgreSQL 13+
# works. Prisma owns the schema (prisma/schema.prisma).
# DIRECT_URL is the non-pooled connection used by `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# ─── Cloudinary ───────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── Payments (PayHero) ───────────────────────────────────────────
# Provider-agnostic payment architecture: the `Payment` model records which
# processor moved the money, so a second provider is an adapter, not a
# migration. PayHero is the first live provider; integration lands in Phase 9.
#
# Every value below is a SAFE PLACEHOLDER. Leave PAYHERO_ENABLED=false until
# Phase 9 — with it false, the backend refuses payment operations with a 501
# rather than calling an API it has not implemented. Never commit real
# credentials, and never point these at production from a development machine.
# These are read by the BACKEND, not by Next.js; they are repeated here only
# so a single grep of `.env.example` shows the whole payment surface.
# `backend/.env.example` is the authoritative and fully commented list — if the
# two ever disagree, that file wins.
PAYHERO_ENABLED=false
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_CHANNEL_ID=
PAYHERO_DEFAULT_CHANNEL_PROVIDER=m-pesa
PAYHERO_CREDENTIAL_ID=
PAYHERO_WEBHOOK_SECRET=
PAYHERO_TIMEOUT_SECONDS=15

# There is no PAYHERO_CALLBACK_URL: the callback handed to PayHero is derived
# from BACKEND_PUBLIC_URL (in backend/.env) so it cannot be configured to point
# somewhere the backend is not. It must be publicly reachable — a provider
# cannot post to localhost.

# A direct Safaricom Daraja integration is RESERVED, not implemented: the
# `PaymentProvider.DARAJA` enum value exists so adding it later is a code
# change rather than a destructive enum migration. No MPESA_* variables are
# read by anything in this repository — the Phase 7 Daraja routes were removed
# in Phase 8. Do not add them back without a matching provider adapter.

# ─── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="MaliHub Kenya <notifications@malihub.co.ke>"

# ─── Auth / Security ──────────────────────────────────────────────
NEXTAUTH_SECRET=
JWT_SECRET=

# ─── Neon Auth POC (evaluation only — NOT the production identity) ──
# Managed Better Auth proof of concept lives at /neon-auth-test and is inert
# unless these are set. Supabase Auth remains the production identity provider
# until a migration is explicitly approved; see docs/neon-auth-poc/REPORT.md.
#
# Server-side variables only. The Neon Auth URL must never be exposed through
# NEXT_PUBLIC_*: the POC's browser code talks to its own proxy route
# (/neon-auth-test/api/auth/[...path]) instead of calling Neon directly.
# NEON_AUTH_URL is accepted as an alias for the value shown in the Neon Console.
NEON_AUTH_BASE_URL=
NEON_AUTH_URL=
# Signing secret for the SDK's session-data cookie; 32+ characters.
NEON_AUTH_COOKIE_SECRET=
# Required only when NODE_ENV=production, to keep the POC dark on live domains.
NEON_AUTH_POC_ENABLED=

# ─── Rate limiting / caching (optional, Upstash Redis) ───────────
# Cache and rate-limit state only — never a primary data store. Redis is
# reused by the FastAPI backend; it must not create a second client for the
# same instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── FastAPI backend (Phase 8) ────────────────────────────────────
# The backend is a SEPARATE service with its OWN environment file:
# backend/.env, templated by backend/.env.example. It is deliberately not
# configured from this file — the two services deploy independently and have
# different secrets.
#
#     cd backend && cp .env.example .env
#
# The only variable the Next.js app needs in order to reach it:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
