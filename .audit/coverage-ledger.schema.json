{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "coverage-ledger.schema.json",
  "title": "MaliHub audit coverage ledger",
  "type": "object",
  "required": ["generated", "entries"],
  "properties": {
    "generated": { "type": "string" },
    "branch": { "type": "string" },
    "note": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["area", "changed", "covers", "case"],
        "properties": {
          "area": { "type": "string" },
          "changed": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "covers": { "type": "array", "items": { "type": "string" } },
          "case": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
