{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "validation-report.schema.json",
  "title": "MaliHub audit validation report",
  "type": "object",
  "required": ["generated", "gates", "overall"],
  "properties": {
    "generated": { "type": "string" },
    "branch": { "type": "string" },
    "note": { "type": "string" },
    "environment": { "type": "object" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "exit", "result", "interpretation"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "exit": { "type": "integer" },
          "result": { "type": "string" },
          "interpretation": { "type": "string", "enum": ["pass", "fail", "reviewed", "skipped"] },
          "note": { "type": "string" }
        }
      }
    },
    "overall": {
      "type": "object",
      "required": ["pass", "fail", "summary"],
      "properties": {
        "pass": { "type": "array", "items": { "type": "string" } },
        "reviewed": { "type": "array", "items": { "type": "string" } },
        "fail": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      }
    }
  }
}
