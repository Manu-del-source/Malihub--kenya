// ============================================================================
// MaliHub Kenya — Database Schema
// Independent PostgreSQL via Prisma
//
// Design notes:
// - `User` mirrors Supabase's `auth.users` (id is the Supabase auth UUID).
//   Supabase owns credentials/OTP/OAuth and NOTHING ELSE — it is the identity
//   provider, not the application database. Prisma owns application data and
//   relations. A DB trigger (see prisma/migrations sql) inserts into
//   public."User" + "Profile" on auth.users insert.
// - Money is stored in integer cents (KES) to avoid float rounding issues.
// - Full-text search uses a generated tsvector column + GIN index, added via
//   raw SQL migration (Prisma doesn't model tsvector natively) — see
//   prisma/migrations/xxxx_product_search/migration.sql.
// - Soft moderation state lives on Product.status; hard deletes are avoided
//   in favor of REMOVED/SUSPENDED so order history stays intact.
// - Payments are provider-agnostic (`provider` + `providerTransactionId` +
//   `providerReference` + `metadata`), never shaped around one processor.
//
// ─── Portability (Phase 8) ─────────────────────────────────────────────────
// Everything *in this file* is plain, standard PostgreSQL and runs unmodified
// on any managed provider (Neon, RDS, Cloud SQL, Supabase, self-hosted):
// UUID PKs, `gen_random_uuid()` (core since PG 13), enums, JSONB, and the
// `tsvector` search column added by raw SQL. Point `DATABASE_URL` at a
// different Postgres and `prisma migrate deploy` and this schema is portable.
//
// The Supabase couplings are all in the *manual SQL layer* alongside it, not
// in the schema: `auth.uid()`/`auth.jwt()` RLS helpers, the `on_auth_user_created`
// trigger, the Realtime publication, and the `avatars` Storage bucket. Those
// are additive defense-in-depth on top of the Prisma data path — see
// ARCHITECTURE.md §6c for the full inventory and the migration path off them.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection string (Neon pooler, PgBouncer, Supavisor, ...).
  url = env("DATABASE_URL")
  // Unpooled connection string, used only for migrations. Provider-neutral:
  // set it to the same value as DATABASE_URL when your Postgres has no
  // separate pooler endpoint.
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SOLD
  ARCHIVED
  SUSPENDED
  REMOVED
}

enum ContactPreference {
  CALL
  WHATSAPP
  CHAT
  ANY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

/// The *channel* a customer pays through — deliberately provider-neutral.
/// `MOBILE_MONEY` covers M-Pesa, Airtel Money, etc.; which processor actually
/// moves the money is `PaymentProvider` below. This enum was `MPESA | CARD |
/// CASH_ON_DELIVERY` before Phase 8 — `MPESA` conflated a channel with a
/// specific rail/provider, which is exactly the coupling the payment
/// architecture is designed to avoid.
enum PaymentMethod {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

/// The *processor* that moves the money. One row per integration.
///
/// - `PAYHERO` — the first live provider (implemented in Phase 9).
/// - `DARAJA`  — reserved for a future direct Safaricom integration. The enum
///               value exists so adding that provider later is a code change,
///               not a destructive enum migration. **No implementation exists
///               and none is planned for Phase 8** — a `Payment` must never be
///               created with this value until `DarajaProvider` ships.
/// - `MANUAL`  — offline/settled-by-hand money (e.g. cash on delivery recorded
///               by an admin). No external processor is involved.
enum PaymentProvider {
  PAYHERO
  DARAJA
  MANUAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum SellerVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// ─── Marketplace payments (Phase 9) ────────────────────────────────────────
// Four concerns kept as four models, deliberately not folded into `Payment`:
// a Payment is "did the buyer's money arrive"; a Settlement is "what does the
// seller net from it, after commission/fees/refunds"; a Payout is "did that
// net amount actually move to the seller"; a PaymentEvent is the raw,
// idempotency-keyed record of every provider callback, independent of
// whether the app understood or acted on it. Collapsing any two of these is
// how a retried webhook ends up double-crediting a seller.

/// Which rail a seller's payout account resolves to. Kept separate from
/// `PaymentMethod` (the *buyer's* channel) — a seller can be paid to M-Pesa
/// even when the buyer paid by card, and conflating the two would be the same
/// mistake `PaymentMethod.MPESA` was before Phase 8 (see the enum comment
/// above `PaymentMethod`).
enum SellerPayoutAccountType {
  MPESA
  BANK
}

/// A seller payout account's onboarding lifecycle. Mirrors
/// `SellerVerificationStatus`'s shape deliberately — same lifecycle, applied
/// to "can this account receive money" instead of "is this seller who they
/// say they are".
enum SellerPayoutAccountStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  REJECTED
}

/// What a `PaymentEvent` row's processing resolved to. Every inbound provider
/// callback gets exactly one of these, whether or not the app acted on it —
/// `IGNORED` covers a duplicate delivery or an event type the app doesn't
/// react to; it must still be recorded, or a provider's retry policy can't be
/// distinguished from a bug that dropped the callback.
enum PaymentEventProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// A `Settlement` row's status. Deliberately does NOT include a `PROCESSING`
/// state — that belongs to `Payout`, the thing that actually moves money.
/// A Settlement's own lifecycle is only ever "not yet payable" → "payable" →
/// "paid", plus the one exception a marketplace needs: a refund or dispute
/// arriving after the seller has already been paid.
enum SettlementStatus {
  PENDING
  ELIGIBLE
  SETTLED
  REVERSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/// What a `CommissionRule` matches against, in priority order (seller and
/// category rules both beat the platform default; `CommissionService` -
/// see `app/services/commission_service.py` - documents the exact
/// precedence). Not a "the more specific rule always wins" free-for-all:
/// precedence is centralized in code, not left to whichever rule a query
/// happens to return first.
enum CommissionRuleScope {
  DEFAULT
  SELLER
  CATEGORY
}

enum CommissionRuleType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  NEW_MESSAGE
  WISHLIST_ALERT
  LISTING_STATUS
  NEW_FAVORITE
  LISTING_SOLD
  LISTING_APPROVED
  LISTING_REJECTED
  NEW_REVIEW
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

enum ReportReason {
  SCAM
  COUNTERFEIT
  PROHIBITED_ITEM
  MISLEADING
  OFFENSIVE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Identity ───────────────────────────────────────────────────────────

/// Mirrors Supabase auth.users — id is the Supabase auth UUID (not a Prisma default).
model User {
  id            String    @id @db.Uuid
  email         String    @unique
  phone         String?   @unique
  role          UserRole  @default(BUYER)
  emailVerified Boolean   @default(false) @map("email_verified")
  isActive      Boolean   @default(true) @map("is_active")
  isBanned      Boolean   @default(false) @map("is_banned")
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profile         Profile?
  seller          Seller?
  products        Product[]        @relation("ProductOwner")
  orders          Order[]          @relation("BuyerOrders")
  wishlists       Wishlist[]
  reviews         Review[]         @relation("ReviewAuthor")
  notifications   Notification[]
  chatsAsBuyer    Chat[]           @relation("ChatBuyer")
  chatsAsSeller   Chat[]           @relation("ChatSeller")
  messagesSent    Message[]        @relation("MessageSender")
  savedSearches   SavedSearch[]
  cartItems       CartItem[]
  reportsFiled    Report[]         @relation("ReportFiledBy")
  supportTickets  SupportTicket[]
  ticketMessages  TicketMessage[]
  listingViews    ListingView[]
  orderReviewsAuthored OrderReview[] @relation("OrderReviewAuthor")
  orderReviewsReceived OrderReview[] @relation("OrderReviewReviewee")
  usersBlocked  BlockedUser[] @relation("BlockerOf")
  blockedByUsers BlockedUser[] @relation("BlockedBy")

  @@map("users")
}

model Profile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  fullName      String   @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  county        String?
  subCounty     String?  @map("sub_county")
  whatsapp      String?
  bio           String?
  onboarded     Boolean  @default(false)
  buyerRatingAverage Decimal? @map("buyer_rating_average") @db.Decimal(3, 2)
  buyerRatingCount   Int      @default(0) @map("buyer_rating_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Seller {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  businessName       String                   @map("business_name")
  slug               String                   @unique
  description        String?
  logoUrl            String?                  @map("logo_url")
  county             String
  subCounty          String?                  @map("sub_county")
  verificationStatus SellerVerificationStatus @default(UNVERIFIED) @map("verification_status")
  idDocumentUrl      String?                  @map("id_document_url")
  kraPin             String?                  @map("kra_pin")
  ratingAverage       Decimal                 @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount         Int                     @default(0) @map("rating_count")
  totalSales          Int                     @default(0) @map("total_sales")
  responseRatePct      Int?                   @map("response_rate_pct")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]

  payoutAccounts  SellerPayoutAccount[]
  settlements     Settlement[]
  payouts         Payout[]
  commissionRules CommissionRule[]

  @@index([verificationStatus])
  @@map("sellers")
}

// ─── Catalog ────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String    @unique
  iconName    String?   @map("icon_name")
  imageUrl    String?   @map("image_url")
  parentId    String?   @map("parent_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  commissionRules CommissionRule[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String           @map("seller_id") @db.Uuid
  ownerId        String           @map("owner_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  title          String
  slug           String           @unique
  description    String
  priceCents     Int              @map("price_cents")
  isNegotiable   Boolean          @default(false) @map("is_negotiable")
  condition      ProductCondition
  brand          String?
  quantity       Int              @default(1)
  contactPreference ContactPreference @default(ANY) @map("contact_preference")
  county         String
  subCounty      String?          @map("sub_county")
  status         ListingStatus    @default(PENDING_REVIEW)
  viewCount      Int              @default(0) @map("view_count")
  favoriteCount  Int              @default(0) @map("favorite_count")
  isFeatured     Boolean          @default(false) @map("is_featured")
  publishedAt    DateTime?        @map("published_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  // searchVector Unsupported("tsvector")? — added via raw SQL migration + GIN index

  seller      Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  owner       User            @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  orderItems  OrderItem[]
  wishlists   Wishlist[]
  reviews     Review[]
  cartItems   CartItem[]
  reports     Report[]
  listingViews ListingView[]

  @@index([categoryId, status])
  @@index([county, status])
  @@index([sellerId])
  @@index([status, publishedAt])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  url          String
  cloudinaryId String   @map("cloudinary_id")
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── Orders & Payments ────────────────────────────────────────────────────

model Order {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber   String      @unique @map("order_number")
  buyerId       String      @map("buyer_id") @db.Uuid
  /// Denormalized from the (single) seller of this order's items. Phase 6's
  /// checkout is single-listing ("Buy Now"), so every order has exactly one
  /// seller today — this field exists so seller order-management queries
  /// don't need a join through items→product→seller. A future multi-seller
  /// cart would need to split checkout into one Order per seller rather
  /// than relax this to nullable/multi-valued.
  sellerId      String      @map("seller_id") @db.Uuid
  status        OrderStatus @default(PENDING)
  subtotalCents Int         @map("subtotal_cents")
  totalCents    Int         @map("total_cents")
  deliveryCounty String?    @map("delivery_county")
  deliveryAddress String?   @map("delivery_address")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  buyer      User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller     Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  payments   Payment[]
  reviews    OrderReview[]
  /// One settlement per Order — consistent with this Order model being
  /// single-seller by design (see the `sellerId` comment above). A
  /// multi-seller cart splits into one Order per seller before checkout, so
  /// this never needs to become an array.
  settlement Settlement?

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Int      @default(1)
  unitPriceCents  Int      @map("unit_price_cents")
  totalCents      Int      @map("total_cents")
  createdAt       DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Provider-agnostic payment record (Phase 8).
///
/// Every column here means the same thing no matter which processor handled
/// the money. The old M-Pesa-specific columns (`mpesaCheckoutRequestId`,
/// `mpesaMerchantRequestId`, `mpesaReceiptNumber`, `mpesaPhoneNumber`,
/// `resultCode`, `resultDesc`) are gone — they are now expressed through the
/// generic provider columns below. Mapping table:
///
///   mpesaCheckoutRequestId  → providerTransactionId
///   mpesaReceiptNumber      → providerReference
///   mpesaPhoneNumber        → payerReference
///   resultCode / resultDesc → failureCode / failureReason
///   mpesaMerchantRequestId  → metadata.merchantRequestId
///
/// `metadata` is intentionally the *only* place provider-specific detail
/// lives. Anything the app queries, filters, indexes, or reconciles on is a
/// real column — JSON is for opaque detail we only ever read back for
/// support/audit (raw provider response fields, masked card brand/last4,
/// provider fee breakdowns, Daraja's `MerchantRequestID`).
model Payment {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId  String          @map("order_id") @db.Uuid
  provider PaymentProvider @default(PAYHERO)
  method   PaymentMethod
  status   PaymentStatus   @default(PENDING)
  /// Integer minor units (KES cents), per the money convention in §6 of
  /// ARCHITECTURE.md — never a float, never a provider-formatted string.
  amountCents Int    @map("amount_cents")
  currency    String @default("KES")
  /// The processor's own transaction identifier (PayHero `transaction_id`,
  /// Daraja `CheckoutRequestID`). Unique so a retried/duplicated provider
  /// callback can be matched to exactly one row and processed idempotently.
  providerTransactionId String? @unique @map("provider_transaction_id")
  /// The processor's settlement/receipt reference a customer can quote to
  /// their bank or operator (PayHero/Daraja M-Pesa receipt number, a card
  /// network reference). Unique for the same idempotency reason.
  providerReference String? @unique @map("provider_reference")
  /// *Our* reference handed to the provider when initiating the charge
  /// (the order number). Providers echo it back in callbacks and
  /// reconciliation exports, so it's the join key when a callback arrives
  /// before we've stored `providerTransactionId`. Required, not nullable:
  /// a Payment is always created from a known Order.
  customerReference String @map("customer_reference")
  /// Provider-reported payer handle, normalized and de-identified where the
  /// provider allows it (an MSISDN for mobile money, a masked PAN for card).
  /// This is the one piece of payer PII we keep on the row, because support
  /// and refund flows genuinely need it; it is never logged (see §13).
  payerReference String? @map("payer_reference")
  /// Provider-specific, opaque detail. Not indexed, not queried.
  metadata Json?
  /// Normalized failure signalling. `failureCode` is a string on purpose:
  /// Daraja reports integers (0 = accepted, 1032 = cancelled), PayHero
  /// reports string statuses — a string column holds both without a lossy
  /// cast, and the provider adapter owns the translation.
  failureCode   String? @map("failure_code")
  failureReason String? @map("failure_reason")
  /// Verbatim provider callback body, kept for dispute resolution and replay
  /// after signature verification. Store the *raw* payload, never a
  /// re-serialized version — the point is being able to re-verify it.
  rawCallbackPayload Json? @map("raw_callback_payload")
  /// Attempts against the same Order. A retry creates a NEW Payment row and
  /// bumps this counter rather than mutating a failed one, so the audit
  /// trail of every attempt survives.
  retryCount Int       @default(0) @map("retry_count")
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  events     PaymentEvent[]
  settlement Settlement?

  @@index([orderId])
  @@index([status])
  /// Reconciliation sweeps ("every PAYHERO payment stuck in PENDING/PROCESSING
  /// for > N minutes") are provider-scoped by nature, so they get a
  /// provider-leading composite index.
  @@index([provider, status])
  @@map("payments")
}

/// Immutable record of one inbound provider callback. Separate from `Payment`
/// on purpose: a `Payment` row is the app's *current* understanding of a
/// transaction; a `PaymentEvent` is *what the provider actually sent*, kept
/// even if the app rejected, ignored, or failed to process it. Reconciling a
/// dispute means replaying this table, not trusting the mutable `Payment`
/// row's present state.
model PaymentEvent {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nullable, not required: a callback can reference a `providerReference`
  /// the app has never seen (wrong reference, a provider retry after the
  /// `Payment` row was somehow lost) and must still be recorded rather than
  /// rejected outright at the persistence layer — rejecting happens in the
  /// service, with a reason, not by making this relation impossible to
  /// satisfy.
  paymentId String? @map("payment_id") @db.Uuid

  provider PaymentProvider
  /// The provider's own event/notification id. Unique with `provider` — this
  /// pair, not `providerTransactionId`, is the idempotency key for "have we
  /// already processed this specific callback", because one transaction can
  /// legitimately generate more than one event (initiated, then succeeded).
  providerEventId String @map("provider_event_id")
  /// Provider vocabulary, not `PaymentEventType` — that enum (in
  /// `providers/payments/base.py`) is the *normalized* small vocabulary the
  /// app reacts to; this column keeps whatever string the provider actually
  /// sent, for reconciliation when a provider's raw event type matters.
  eventType String @map("event_type")
  /// SHA-256 of the verified raw body. Lets a duplicate delivery be detected
  /// even before the provider assigns/repeats an event id, and gives a
  /// tamper-evidence check independent of the provider's own signature.
  payloadHash String @map("payload_hash")
  /// Redacted provider payload — never the verbatim raw body. Use the same
  /// `_strip_sensitive` field list `providers/payments/base.py` already
  /// defines (`raw`, `signature`, `payer`, `phone_number`) before writing
  /// here; see `docs/payments/webhook-security.md`.
  rawPayload Json? @map("raw_payload")

  processingStatus PaymentEventProcessingStatus @default(RECEIVED) @map("processing_status")
  processedAt      DateTime?                     @map("processed_at")
  receivedAt       DateTime                      @default(now()) @map("received_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// The idempotency guarantee: the same provider cannot register the same
  /// event id twice, at the database level, not just in application logic.
  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([processingStatus, receivedAt])
  @@map("payment_events")
}

/// A seller's registered payout destination with a marketplace-capable
/// payment provider. Deliberately provider-shaped the same way `Payment` is:
/// `provider` + `providerAccountId` + `providerMetadata`, nothing
/// processor-specific promoted to a real column. What this table explicitly
/// never stores: an M-Pesa PIN, a bank password, a card CVV, or any raw
/// banking credential — the provider owns that onboarding surface (see
/// `docs/payments/payment-architecture.md`), MaliHub only stores the
/// resulting reference.
model SellerPayoutAccount {
  id       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String                    @map("seller_id") @db.Uuid
  provider PaymentProvider
  /// The provider's own identifier for this payee (a Paystack
  /// `subaccount_code`, a Flutterwave subaccount id, ...). Never a secret —
  /// safe to log, safe to show the seller.
  providerAccountId String                    @map("provider_account_id")
  accountType        SellerPayoutAccountType   @map("account_type")
  status             SellerPayoutAccountStatus @default(PENDING_VERIFICATION)
  /// Exactly one default account per seller; enforced in the service layer
  /// (a partial unique index on `(sellerId) WHERE isDefault` is the Postgres
  /// way to enforce it at the DB level too — add via a manual SQL migration
  /// if/when this matters, same pattern as `manual_phase8_provider_agnostic_payments.sql`).
  isDefault Boolean @default(false) @map("is_default")
  /// Non-secret provider detail only: bank name, masked account tail,
  /// verification metadata. Never a token, secret, or credential — those
  /// belong in the app's secret manager, not a JSON column a support agent's
  /// query can surface.
  providerMetadata Json? @map("provider_metadata")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  seller  Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  payouts Payout[]

  @@unique([provider, providerAccountId])
  @@index([sellerId, isDefault])
  @@index([status])
  @@map("seller_payout_accounts")
}

/// A configurable commission rate. Resolution precedence (most specific
/// wins), implemented in `CommissionService`, not in a database query:
/// an active `SELLER`-scoped rule for this seller > an active
/// `CATEGORY`-scoped rule for the product's category > the active `DEFAULT`
/// rule. Exactly one `DEFAULT` rule should be active at a time; the service
/// — not a database constraint — is responsible for that invariant, because
/// "exactly one" is easy to express in code and awkward as SQL.
model CommissionRule {
  id     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope  CommissionRuleScope @default(DEFAULT)
  /// Set only when scope = SELLER.
  sellerId String? @map("seller_id") @db.Uuid
  /// Set only when scope = CATEGORY.
  categoryId String? @map("category_id") @db.Uuid

  type CommissionRuleType
  /// Basis points (1/100th of a percent), not a float percentage — 500 =
  /// 5.00%. Integer, so the rounding behaviour of a rate change is exact and
  /// reviewable, the same reason amounts are integer cents rather than a
  /// decimal/float KES value.
  percentageBps Int? @map("percentage_bps")
  /// Set only when type = FIXED. Same integer-cents convention as `Payment`.
  fixedAmountCents Int? @map("fixed_amount_cents")

  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  seller   Seller?   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
  @@index([sellerId])
  @@index([categoryId])
  @@map("commission_rules")
}

/// What a seller nets from one Order, after MaliHub's commission and any
/// provider fee/refund adjustment. One row per Order (see the `Order.settlement`
/// comment) — never a row spanning multiple sellers, however many providers
/// support multi-party splits, because `Order` itself is single-seller.
model Settlement {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId  String @unique @map("order_id") @db.Uuid
  sellerId String @map("seller_id") @db.Uuid
  /// The specific successful `Payment` this settlement is computed from.
  /// An Order can accumulate multiple `Payment` attempts (see
  /// `Payment.retryCount`); this points at the one that actually succeeded.
  paymentId String @map("payment_id") @db.Uuid

  grossAmountCents      Int @map("gross_amount_cents")
  commissionAmountCents Int @map("commission_amount_cents")
  /// What the payment provider charged MaliHub for collecting the payment.
  /// Zero until the selected provider's fee model is confirmed — see
  /// `docs/payments/provider-comparison.md`, which deliberately does not
  /// assume this is charged to the seller.
  providerFeeCents     Int @default(0) @map("provider_fee_cents")
  refundAmountCents    Int @default(0) @map("refund_amount_cents")
  adjustmentAmountCents Int @default(0) @map("adjustment_amount_cents")
  /// gross - commission - providerFee - refund + adjustment. Computed and
  /// written by `SettlementService`, never derived at query time — a
  /// reversal or refund must recompute and rewrite this explicitly so the
  /// audit trail shows the change, not just the new number.
  netAmountCents Int @map("net_amount_cents")

  status     SettlementStatus @default(PENDING)
  /// Set once the marketplace's configurable settlement-timing policy is
  /// satisfied (see `docs/payments/settlement-lifecycle.md`) — delivery
  /// confirmation, a cancellation window, etc. Null while still PENDING.
  eligibleAt DateTime?        @map("eligible_at")
  /// Set when every Payout against this settlement reaches COMPLETED.
  settledAt  DateTime?        @map("settled_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  payouts Payout[]

  @@index([sellerId, status])
  @@index([status, eligibleAt])
  @@map("settlements")
}

/// One instruction to actually move a Settlement's net proceeds to a seller.
/// Separate from `Settlement` because a payout can fail and retry
/// independently of the (already-fixed) financial calculation it pays out —
/// re-running the math on retry would be the bug this split prevents.
model Payout {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String @map("seller_id") @db.Uuid
  settlementId    String @map("settlement_id") @db.Uuid
  payoutAccountId String @map("payout_account_id") @db.Uuid

  amountCents Int    @map("amount_cents")
  currency    String @default("KES")
  provider    PaymentProvider
  /// The provider's own payout/transfer id. Null until the provider
  /// acknowledges the request — see the caution on `Payment.paidAt` in the
  /// module comment above: never set from a submission response alone.
  providerPayoutId String? @unique @map("provider_payout_id")
  /// Caller-generated, required. The defence against "MaliHub's own retry
  /// logic submits the same payout twice" — a concern a provider-side event
  /// id can't cover, because that id doesn't exist until the provider has
  /// already accepted the (possibly duplicate) request.
  idempotencyKey String @unique @map("idempotency_key")

  status        PayoutStatus @default(PENDING)
  failureCode   String?      @map("failure_code")
  failureReason String?      @map("failure_reason")
  /// Non-secret provider response detail only, same redaction rule as
  /// `Payment.metadata`.
  metadata Json?

  /// Set when MaliHub submits the request to the provider — NOT proof the
  /// money moved. Mirrors the `Payment.paidAt` distinction: never mark a
  /// Payout COMPLETED because MaliHub successfully made the API call.
  initiatedAt DateTime? @map("initiated_at")
  /// Set only from a trusted provider confirmation (webhook or verified
  /// status poll), matching the Phase 9 brief's rule that a payout is never
  /// COMPLETED merely because MaliHub submitted it.
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  seller        Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  settlement    Settlement          @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payoutAccount SellerPayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)

  @@index([sellerId, status])
  @@index([settlementId])
  @@index([provider, status])
  @@map("payouts")
}

// ─── Engagement ─────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([productId, authorId])
  @@index([productId])
  @@map("reviews")
}

enum ReviewDirection {
  BUYER_TO_SELLER
  SELLER_TO_BUYER
}

/// Post-transaction mutual rating (Phase 6) — distinct from `Review` above,
/// which rates a *product* and predates any transaction. This rates a
/// *person*, tied to a completed `Order`, in either direction. Kept as a
/// separate model rather than overloading `Review` since the two have
/// different identity (product vs. person) and different uniqueness rules.
model OrderReview {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String          @map("order_id") @db.Uuid
  authorId   String          @map("author_id") @db.Uuid
  revieweeId String          @map("reviewee_id") @db.Uuid
  direction  ReviewDirection
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author   User  @relation("OrderReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewee User  @relation("OrderReviewReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  // One review per person per direction per order — a buyer can't rate the
  // same seller twice for the same purchase.
  @@unique([orderId, authorId, direction])
  @@index([revieweeId])
  @@map("order_reviews")
}

model SavedSearch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  query     String?
  filters   Json
  isAlertOn Boolean  @default(true) @map("is_alert_on")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

// ─── Messaging ──────────────────────────────────────────────────────────

model Chat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId    String   @map("buyer_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  productId  String?  @map("product_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  /// Per-user, independent state — archiving/deleting is something each
  /// participant does to their own view of the conversation, never both
  /// sides at once (that would mean actually deleting shared history).
  buyerArchived   Boolean   @default(false) @map("buyer_archived")
  sellerArchived  Boolean   @default(false) @map("seller_archived")
  buyerDeletedAt  DateTime? @map("buyer_deleted_at")
  sellerDeletedAt DateTime? @map("seller_deleted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  buyer    User      @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("ChatSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, sellerId, productId])
  @@map("chats")
}

/// One-directional block — A blocking B stops A↔B messaging regardless of
/// who initiates, but is invisible to B (no "you've been blocked" signal,
/// matching how most consumer messaging products handle this to avoid
/// escalating harassment situations).
model BlockedUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockerOf", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocked_users")
}

model Message {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId     String    @map("chat_id") @db.Uuid
  senderId   String    @map("sender_id") @db.Uuid
  content    String?
  imageUrl   String?   @map("image_url")
  readAt     DateTime? @map("read_at")
  editedAt   DateTime? @map("edited_at")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("messages")
}

// ─── Notifications ──────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  linkUrl   String?             @map("link_url")
  isRead    Boolean             @default(false) @map("is_read")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// Individual view events, distinct from Product.viewCount (a fast running
/// total). This table exists for dedup (see recordListingViewAction) and
/// future analytics (views-over-time charts) — viewCount stays the field
/// every read-path uses for display since summing this table per-request
/// would be needlessly expensive.
model ListingView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewerId  String?  @map("viewer_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewer  User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("listing_views")
}

// ─── Trust & Safety / Admin ──────────────────────────────────────────────

model Report {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  resolvedAt DateTime?    @map("resolved_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReportFiledBy", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}

model SupportTicket {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

// ─── Security & audit ─────────────────────────────────────────────────────

/// Append-only security audit trail, written exclusively through
/// `src/services/audit-service.ts` (`logAuditEvent`).
///
/// Phase 7 shipped the service and the RLS policy for this table
/// (`manual_phase7_security.sql` targets `public.audit_logs`) but the Prisma
/// model itself never landed in the schema — so `prisma.auditLog` in
/// audit-service.ts had no generated client accessor. Added in Phase 8 to
/// close that gap; the table name, column names and `@@map` here match the
/// SQL Phase 7 already expects.
///
/// Deliberate design choices:
/// - **No foreign keys.** `actorId` points at `users.id` in shape only. An
///   audit trail must outlive its subject: cascade-deleting a banned or
///   deleted user would erase exactly the history you need to explain the
///   ban, and failed-login rows routinely describe emails that never became
///   users at all. Integrity here is worth less than immutability.
/// - **`action` is a free-form string at the DB level**, constrained by the
///   `AuditAction` union in audit-service.ts rather than by a Postgres enum.
///   Adding a new audited action is then a one-line TypeScript change, not a
///   destructive `ALTER TYPE` migration.
/// - **Append-only by convention.** Nothing updates or deletes these rows;
///   `updatedAt` is intentionally absent so an accidental write shows up in
///   review.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action     String
  /// Supabase auth UUID of whoever acted. Null for pre-authentication events
  /// (a failed login, a rate-limited signup) where no user row exists yet.
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email")
  /// Free-form subject labels ("listing", "user", "report") paired with
  /// `targetId`. Kept as strings, not a relation, for the same reason as
  /// `actorId`.
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  /// Non-sensitive event detail. Never put passwords, tokens, API keys or
  /// full payment payloads in here — see the logging redaction rules (§13).
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  /// `countRecentFailedLogins()` filters action + createdAt; the admin
  /// timeline view filters actorEmail + createdAt. Both get a covering
  /// composite index rather than single-column ones.
  @@index([action, createdAt])
  @@index([actorEmail, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
