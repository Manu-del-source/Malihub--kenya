# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MaliHub Kenya"
NODE_ENV=development

# ─── Neon Auth — PRIMARY AUTHENTICATION ───────────────────────────
# Managed Better Auth issues and verifies every user session. Passwords, email
# verification and Google OAuth all live here; the application database holds no
# credentials. Both variables are REQUIRED — without them middleware fails
# closed and redirects every protected route to /login.
#
# Values come from the Neon Console: Project → Branch → Auth → Configuration.
# Server-side only. The Auth URL must NEVER be exposed through NEXT_PUBLIC_*:
# browser code talks to MaliHub's own Server Actions, not to the auth service.
# NEON_AUTH_URL is accepted as an alias for the value the Console labels
# "Auth URL". A placeholder left over from this file is rejected, not used.
NEON_AUTH_BASE_URL=
NEON_AUTH_URL=
# Signing secret for the SDK's local session-data cookie (HS256). Minimum 32
# characters — shorter values are rejected at startup rather than at request
# time. Keep it STABLE across deploys: rotating it silently signs everybody out.
NEON_AUTH_COOKIE_SECRET=

# Legacy account linking. OFF by default, and it should stay off except during
# a documented cutover window.
#
# When ON, a brand-new Neon Auth identity may claim an existing MaliHub
# `users` row that has the same email address and no `auth_user_id` yet — which
# is how a pre-migration account gets mapped without a data migration. When OFF
# (the default) that sign-in is refused with "your account is being migrated"
# rather than silently attaching somebody's orders and listings to a new
# identity. Read docs/auth/MIGRATION.md §4 before turning it on.
MALIHUB_AUTH_LINK_UNMAPPED_BY_EMAIL=false

# ─── Supabase — LEGACY ONLY (no runtime feature uses it) ──────────
# Phase 4 of docs/SUPABASE-REMOVAL-PLAN.md removed the last Supabase calls from
# this app. Everything it used to provide now runs elsewhere:
#   - Storage  (avatars) → Cloudinary, POST /api/avatar/upload      (Phase 2)
#   - Realtime (chat)    → FastAPI WebSocket + Upstash Redis        (Phase 3)
#   - Auth               → Neon Managed Better Auth (§ above)
#
# NEXT_PUBLIC_SUPABASE_URL is the ONE variable that is still REQUIRED — and only
# for data that has not been migrated yet. It is the project reference legacy
# `Profile.avatarUrl` values are validated against (isOwnSupabaseStorageUrl in
# src/lib/validations/upload-security.ts) and the source the avatar migration
# reads. Remove it, together with the `*.supabase.co` entries in next.config.ts,
# only after scripts/migrate-avatars-to-cloudinary.mjs has run AND production
# verification shows no avatar still pointing at Supabase.
NEXT_PUBLIC_SUPABASE_URL=
#
# ROLLBACK-ONLY — unread by the default deployment. The retired auth
# implementation is preserved, unreferenced, in src/lib/supabase/auth-legacy.ts
# (docs/auth/MIGRATION.md §9), and these values exist so that undoing the Neon
# Auth cutover stays a configuration change rather than a revert. Restoring that
# path also needs `npm install @supabase/supabase-js@2.117.3`: the SDK left
# package.json in Phase 4, and `@supabase/ssr` — kept for the rollback pair —
# only declares it as a peer dependency.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Read by the FastAPI backend ONLY when it runs AUTH_PROVIDER=supabase-legacy.
# The default backend verifies Neon Auth JWTs against the service's published
# JWKS at `{NEON_AUTH_BASE_URL}/.well-known/jwks.json`, so this is unread unless
# that provider is explicitly selected (docs/auth/MIGRATION.md §7 and §9).
SUPABASE_JWT_SECRET=

# ─── Application database (independent PostgreSQL) ────────────────
# Managed Postgres of your choice — Neon, Supabase Postgres, RDS, … The code
# uses no Supabase-specific database features, so any standard PostgreSQL 13+
# works. Prisma owns the schema (prisma/schema.prisma).
# DIRECT_URL is the non-pooled connection used by `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# ─── Cloudinary ───────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Public Cloudinary API key used by the signed browser widget (not the secret).
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Set true to stop new listing-image uploads immediately (server-side kill switch).
CLOUDINARY_UPLOADS_PAUSED=false

# ─── Payments (Paystack — the active provider, Phase 10) ──────────
# M-Pesa collection for buyer orders lives ENTIRELY in the Next.js app:
#   POST /api/payments/paystack/initialize   (buyer starts a checkout)
#   POST /api/payments/paystack/webhook      (Paystack → MaliHub settlement)
#   GET/POST /api/payments/paystack/verify   (buyer's status/verification)
#
# Every value below is a SAFE PLACEHOLDER. Never commit real credentials and
# never prefix the secret key with NEXT_PUBLIC_ — it is server-only.
#
# PAYSTACK_SECRET_KEY — from Paystack Dashboard → Settings → API Keys.
#   Used for (a) authenticated API calls (initialize/verify) and (b) VERIFYING
#   inbound webhook signatures: Paystack signs each delivery with
#   `x-paystack-signature: hex(HMAC-SHA512(raw_body, PAYSTACK_SECRET_KEY))`,
#   so there is deliberately NO separate webhook-secret variable — inventing
#   one would break verification. Without a valid key the webhook endpoint
#   fails CLOSED (401 on every delivery).
#   Use a `sk_test_…` key in development and a `sk_live_…` key in production;
#   the format is validated at startup.
PAYSTACK_SECRET_KEY=
# Publicly reachable URL where the BUYER'S BROWSER lands when Paystack's
# hosted checkout closes (the provider's `callback_url` field). It is a
# navigation convenience only — settlement happens via the webhook and the
# verify endpoint, never from this redirect. Point it at THIS deployment,
# e.g. https://malihub.example.com/checkout/payment-result.
PAYSTACK_CALLBACK_URL=https://malihub.example.com/checkout/payment-result
# Inbound webhook URL — set in Paystack Dashboard → Settings → Webhooks
# (test mode and live mode are configured separately), e.g.
# https://malihub.example.com/api/payments/paystack/webhook. It is NOT an
# environment variable: the provider pushes to it, it does not call out.
#
# Optional: outbound API timeout (1000–60000 ms); defaults to 15000.
PAYSTACK_TIMEOUT_MS=15000

# A direct Safaricom Daraja integration is RESERVED, not implemented: the
# `PaymentProvider.DARAJA` enum value exists so adding it later is a code
# change rather than a destructive enum migration. No MPESA_* variables are
# read by anything in this repository — the Phase 7 Daraja routes were removed
# in Phase 8. Do not add them back without a matching provider adapter.

# ─── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="MaliHub Kenya <notifications@malihub.co.ke>"

# ─── Auth / Security ──────────────────────────────────────────────
NEXTAUTH_SECRET=
JWT_SECRET=

# ─── Rate limiting / caching (optional, Upstash Redis) ───────────
# Cache and rate-limit state only — never a primary data store. Redis is
# reused by the FastAPI backend; it must not create a second client for the
# same instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── FastAPI backend (Phase 8) ────────────────────────────────────
# The backend is a SEPARATE service with its OWN environment file:
# backend/.env, templated by backend/.env.example. It is deliberately not
# configured from this file — the two services deploy independently and have
# different secrets.
#
#     cd backend && cp .env.example .env
#
# The FastAPI backend's HTTP base URL. NOTE (Phase 5 audit): no code in src/
# currently reads this — buyer payments run in the Next.js app itself, and the
# realtime path uses NEXT_PUBLIC_CHAT_WS_BASE_URL (below). It is kept as the
# documented entry point for the Phase 8 backend API and is safe to leave set.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
#
# Chat realtime (FastAPI WebSocket). The browser cannot send its httpOnly
# session cookie across origins, so it first calls the same-origin
# POST /api/chat/ws-ticket, which stores a one-shot ticket in Upstash Redis
# and returns a `wss://…/api/v1/chat/ws?ticket=…` URL. Set this to the
# WebSocket-reachable base of the FastAPI host (no trailing slash):
#
#     NEXT_PUBLIC_CHAT_WS_BASE_URL=wss://api.malihub.example.com
#
# When empty, chat realtime is OFF and messaging silently degrades to
# HTTP (history + send/edit/read all still work). Leave empty on local
# dev unless the backend is also running:
NEXT_PUBLIC_CHAT_WS_BASE_URL=
#
# ── Deploy the backend FIRST, or in the same window ───────────────
# The backend verifies the tokens this app's users present, so it must be
# pointed at the same Neon Auth branch before this app starts issuing those
# tokens — otherwise every authenticated API call fails. In backend/.env:
#
#     AUTH_PROVIDER=neon
#     NEON_AUTH_BASE_URL=<same value as above>
#     DATABASE_URL=<same application database>
#
# DATABASE_URL is no longer optional for auth: role, onboarding and seller
# status are read from Postgres per request, because the token carries none of
# them. See docs/auth/MIGRATION.md §7.

# ─── Dropshipping estimate configuration (server-only, non-secret) ─────
# These values are commercial decisions, NOT keys. Leave them unset/zero until
# a documented provider rate schedule and tax decision exist. Unknown rates are
# reported as estimates with warnings; the app never invents a fee or tax rate.
# See docs/DROPSHIPPING-GOVERNANCE-PHASE.md.
# DROPSHIPPING_PAYMENT_FEE_BPS=0
# DROPSHIPPING_TAX_BPS=0
# DROPSHIPPING_FEE_CONFIG_VERIFIED=false
# DROPSHIPPING_STOCK_MAX_AGE_HOURS=48
