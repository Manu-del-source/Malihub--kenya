# npm install/ci options for this repository.
#
# `legacy-peer-deps` is required by the Neon Auth POC dependency:
# `@neondatabase/auth@0.5.0-beta` declares `peerDependencies.next: ">=16.0.0"`
# (an optional peer), while this app is pinned to Next.js 15. The SDK was
# verified working on Next 15.5.22 (see docs/neon-auth-poc/REPORT.md §M.1), but
# npm's strict peer resolution rejects the install outright — including on Vercel,
# where `npm ci` has no flag to opt out. Setting it here keeps local installs and
# deployment installs identical.
#
# Remove this file when @neondatabase/auth widens its Next.js peer range or the
# application moves to Next 16.
legacy-peer-deps=true
