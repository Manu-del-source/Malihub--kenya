{
  "name": "malihub-kenya",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.29"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/deploy-production-migrations.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "backend:install": "cd backend && python -m pip install -e '.[dev]'",
    "backend:dev": "cd backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "backend:test": "cd backend && python -m pytest",
    "backend:lint": "cd backend && python -m ruff check app tests",
    "backend:format": "cd backend && python -m ruff format app tests"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@prisma/client": "6.2.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-avatar": "1.1.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@react-email/components": "1.0.12",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.62.11",
    "@upstash/ratelimit": "^1.0.3",
    "@upstash/redis": "^1.34.3",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "11.15.0",
    "lucide-react": "0.469.0",
    "nanoid": "5.1.16",
    "next": "15.5.27",
    "next-cloudinary": "6.16.0",
    "next-safe-action": "7.10.2",
    "prisma": "6.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "recharts": "3.10.1",
    "resend": "4.0.1",
    "server-only": "0.0.1",
    "socket.io-client": "4.8.1",
    "sonner": "1.7.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@faker-js/faker": "10.5.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tsx": "4.23.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
